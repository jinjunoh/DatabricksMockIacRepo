# Terraform state — never commit
*.tfstate
*.tfstate.backup
*.tfstate.lock.info

# Terraform working directory
.terraform/
.terraform.lock.hcl

# Variable files may contain secrets — use .example files instead
*.tfvars
!*.tfvars.example

# Crash logs
crash.log
crash.*.log

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json
